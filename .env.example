# ─────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ─────────────────────────────────────────
# API backend (utilisé par OpenClaw uniquement)
# ─────────────────────────────────────────
API_HOST=localhost
API_PORT=8000
SECRET_KEY=change-this-secret-key-before-production

# ─────────────────────────────────────────
# Gmail API – Compte 1 (secondaire)
# ─────────────────────────────────────────
GMAIL_CLIENT_ID_1=
GMAIL_CLIENT_SECRET_1=
GMAIL_REFRESH_TOKEN_1=
GMAIL_EMAIL_1=your.secondary@gmail.com

# ─────────────────────────────────────────
# Gmail API – Compte 2 (principal)
# ─────────────────────────────────────────
GMAIL_CLIENT_ID_2=
GMAIL_CLIENT_SECRET_2=
GMAIL_REFRESH_TOKEN_2=
GMAIL_EMAIL_2=your.primary@gmail.com

# ─────────────────────────────────────────
# Répartition des comptes (poids relatifs)
# Ex : 50/30/20 → compte 1 : ~50 %, compte 2 : ~30 %, compte 3 : ~20 %
# ─────────────────────────────────────────
GMAIL_WEIGHT_1=50
GMAIL_WEIGHT_2=50
GMAIL_WEIGHT_3=50

# ─────────────────────────────────────────
# Limites d'envoi
# ─────────────────────────────────────────
DAILY_SEND_LIMIT_PER_ACCOUNT=30
HOURLY_SEND_LIMIT_PER_ACCOUNT=5
MIN_DELAY_BETWEEN_SENDS_SEC=60
MAX_DELAY_BETWEEN_SENDS_SEC=180
COMPANY_WEEKLY_SEND_LIMIT=4

# ─────────────────────────────────────────
# Vérification email (QuickEmailVerification)
# ─────────────────────────────────────────
# Option A: clé directe via env (prioritaire)
QUICKEMAILVERIFICATION_API_KEY=

# Option B: chemin d'un fichier sécurisé contenant uniquement la clé
QUICKEMAILVERIFICATION_API_KEY_FILE=./data/secure/quickemailverification_api_key.txt

# Clé secondaire (fallback en cas de limite sur la clé principale)
# Option A: clé directe
QUICKEMAILVERIFICATION_API_KEY_2=
# Option B: chemin d'un fichier sécurisé contenant uniquement la clé secondaire
QUICKEMAILVERIFICATION_API_KEY_FILE_2=./data/secure/quickemailverification_api_key_2.txt

# Timeout HTTP (secondes)
QUICKEMAILVERIFICATION_TIMEOUT_SEC=10

# Durée de validité (jours) du dernier statut email avant nouvelle vérification
EMAIL_VERIFICATION_TTL_DAYS=30

# ─────────────────────────────────────────
# Expéditeur
# ─────────────────────────────────────────
SENDER_NAME=Your Name
SENDER_WEBSITE=https://votresite.com

# ─────────────────────────────────────────
# Pièce jointe CV (optionnel)
# ─────────────────────────────────────────
CV_PATH=./data/cv.pdf
