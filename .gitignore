# Base de données
data/app.db
*.db
*.sqlite

# Variables d'environnement
.env
.env.local
.env.*.local

# Build PyQt6 / PyInstaller
build/
dist/
*.spec

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
